__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.egg-info/
.venv/
tmp/
# Published runs are tracked -- they are what the dashboard serves, and keeping
# them in git makes a run's provenance part of the history. A 2.1 MB report is
# roughly 75 KB as a git object, so a decade of runs is under a megabyte.
# Ad-hoc local output is not tracked.
reports/report.json
reports/comparison.json
reports/baseline.json
reports/history.json

# The repositories a run reads, cloned here by --clones and by the workflow.
# They are inputs, not output: each is recorded in the report under `sources`
# with the commit it was read at, which is the provenance that matters. Left
# untracked they made `git status --porcelain` report the tree as dirty, so
# every CI run stamped itself `dirty: true` and disqualified itself as a
# comparison baseline -- which is the one thing the pre-cruise check needs.
repos/
baseline/

# session transcript carried over from metadataVerification
*.jsonl
.pytest_cache/
build/
dist/
dashboard/node_modules/
dashboard/.nuxt/
dashboard/.output/
dashboard/public/reports/
# symlink nuxi generate leaves behind; "dist/" does not match a symlink
dashboard/dist
